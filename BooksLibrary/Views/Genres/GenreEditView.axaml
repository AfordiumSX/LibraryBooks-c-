<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BooksLibrary.ViewModels.Genres"
        x:Class="BooksLibrary.Views.Genres.GenreEditView"
        x:DataType="vm:GenreEditViewModel"
        Title="{Binding WindowTitle}"
        Width="480" Height="280"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="{Binding WindowTitle}"
               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <StackPanel Grid.Row="1" Spacing="12">
      <StackPanel>
        <TextBlock Text="Название" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Name}" PlaceholderText="Введите название жанра"/>
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="Red"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8" Margin="0,16,0,0">
      <Button Command="{Binding SaveCommand}"   Content="Сохранить" IsDefault="True"/>
      <Button Command="{Binding CancelCommand}" Content="Отмена"    IsCancel="True"/>
    </StackPanel>

  </Grid>
</Window>
