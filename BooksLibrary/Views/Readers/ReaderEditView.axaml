<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BooksLibrary.ViewModels.Readers"
        x:Class="BooksLibrary.Views.Readers.ReaderEditView"
        x:DataType="vm:ReaderEditViewModel"
        Title="{Binding WindowTitle}"
        Width="500" Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <Grid RowDefinitions="Auto,*,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="{Binding WindowTitle}"
               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <StackPanel Grid.Row="1" Spacing="12">
      <StackPanel>
        <TextBlock Text="ФИО" Margin="0,0,0,4"/>
        <TextBox Text="{Binding FullName}" PlaceholderText="Иванов Иван Иванович"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="Телефон" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Phone}" PlaceholderText="+7 (999) 123-45-67"/>
        <TextBlock Text="{Binding PhoneError}"
                   Foreground="Red"
                   FontSize="12"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   IsVisible="{Binding PhoneError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>

      <StackPanel>
        <TextBlock Text="E-mail" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Email}" PlaceholderText="example@mail.com"/>
        <TextBlock Text="{Binding EmailError}"
                   Foreground="Red"
                   FontSize="12"
                   Margin="0,4,0,0"
                   TextWrapping="Wrap"
                   IsVisible="{Binding EmailError, Converter={x:Static ObjectConverters.IsNotNull}}"/>
      </StackPanel>

      <TextBlock Text="{Binding ErrorMessage}"
                 Foreground="Red"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8" Margin="0,16,0,0">
      <Button Command="{Binding SaveCommand}"   Content="Сохранить" IsDefault="True"/>
      <Button Command="{Binding CancelCommand}" Content="Отмена"    IsCancel="True"/>
    </StackPanel>

  </Grid>
</Window>
