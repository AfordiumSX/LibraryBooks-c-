<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BooksLibrary.ViewModels.Books"
             x:Class="BooksLibrary.Views.Books.BookListView"
             x:DataType="vm:BookListViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16">

    <TextBlock Grid.Row="0" Text="Каталог книг"
               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

    <TextBox Grid.Row="1"
             Text="{Binding SearchText}"
             PlaceholderText="Поиск по названию, автору или ISBN..."
             Margin="0,0,0,8"/>

    <Grid Grid.Row="2">
      <DataGrid ItemsSource="{Binding Books}"
                SelectedItem="{Binding SelectedBook}"
                AutoGenerateColumns="False"
                CanUserSortColumns="True"
                CanUserResizeColumns="True"
                IsReadOnly="True"
                HeadersVisibility="All"
                GridLinesVisibility="All"
                MinHeight="200"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID"        Binding="{Binding Id}"             Width="60"/>
          <DataGridTextColumn Header="Название"  Binding="{Binding Title}"          Width="*"/>
          <DataGridTextColumn Header="Автор"     Binding="{Binding AuthorName}"     Width="180"/>
          <DataGridTextColumn Header="Жанр"      Binding="{Binding GenreName}"      Width="120"/>
          <DataGridTextColumn Header="Год"       Binding="{Binding Year}"           Width="70"/>
          <DataGridTextColumn Header="Всего"     Binding="{Binding Quantity}"       Width="70"/>
          <DataGridTextColumn Header="Свободно"  Binding="{Binding AvailableCount}" Width="90"/>
          <DataGridTextColumn Header="ISBN"      Binding="{Binding ISBN}"           Width="140"/>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="Книг нет. Нажмите «Добавить»."
                 Foreground="#888"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False"
                 IsVisible="{Binding !Books.Count}"/>
    </Grid>

    <TextBlock Grid.Row="3"
               Text="{Binding ErrorMessage}"
               Foreground="Red"
               IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
               TextWrapping="Wrap"
               Margin="0,8,0,0"/>

    <StackPanel Grid.Row="4" Orientation="Horizontal"
                Spacing="8" Margin="0,8,0,0">
      <Button Command="{Binding LoadCommand}"   Content="Обновить"/>
      <Button Command="{Binding AddCommand}"    Content="Добавить"/>
      <Button Command="{Binding EditCommand}"   Content="Изменить"/>
      <Button Command="{Binding DeleteCommand}" Content="Удалить"/>
    </StackPanel>

  </Grid>
</UserControl>
